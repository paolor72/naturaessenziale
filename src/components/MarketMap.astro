---
const mapsUrl =
  "https://www.google.com/maps/search/?api=1&query=Musei+San+Domenico+Forlì";

const mapsEmbedUrl =
  "https://www.google.com/maps?q=Musei+San+Domenico+Forlì&output=embed";
---

<div class="mt-8 rounded-3xl border border-ne-indaco/15 bg-ne-bianco p-6">
  <p class="text-lg font-semibold text-ne-indaco">
    Dove trovarmi
  </p>

  <p class="mt-3 text-ne-indaco">
    Forlì · di fronte ai Musei San Domenico
  </p>

  <div id="market-map-container" class="mt-5">
    <div
      id="market-map-placeholder"
      class="flex min-h-56 items-center justify-center rounded-2xl bg-ne-indaco/5 p-6 text-center"
    >
      <div>
        <p class="font-semibold text-ne-indaco">
          Mappa non caricata
        </p>

        <p class="mt-2 text-sm leading-relaxed text-ne-indaco">
          Puoi aprire comunque l'indirizzo su Google Maps.
        </p>

        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex items-center justify-center rounded-full border-2 border-ne-indaco bg-ne-indaco px-6 py-3 font-semibold text-ne-bianco transition-colors hover:bg-ne-bianco hover:text-ne-indaco"
        >
          Apri su Google Maps
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ mapsEmbedUrl }}>
  const consent = localStorage.getItem("ne_cookie_consent");
  const container = document.getElementById("market-map-container");

  if (consent === "accepted" && container) {
    container.innerHTML = `
      <div class="overflow-hidden rounded-2xl">
        <iframe
          src="${mapsEmbedUrl}"
          width="100%"
          height="320"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
          title="Mappa del mercato di Forlì davanti ai Musei San Domenico"
        ></iframe>

        <div class="mt-4 text-center">
          <a
            href="https://www.google.com/maps/search/?api=1&query=Musei+San+Domenico+Forlì"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full border-2 border-ne-indaco bg-ne-indaco px-6 py-3 font-semibold text-ne-bianco transition-colors hover:bg-ne-bianco hover:text-ne-indaco"
          >
            Apri su Google Maps
          </a>
        </div>
      </div>
    `;
  }
</script>